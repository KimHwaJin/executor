        <mxCell id="c29" value="&lt;b&gt;Pod끼리 직접 통신하지 않는다.&lt;/b&gt; API와 Worker도 메모리를 공유하지 않고 DB로만 이야기한다.&lt;br&gt;모든 조율은 PostgreSQL 행(lease, fencing token, SKIP LOCKED)으로 하므로 Pod 수가 바뀌어도 설정 변경이 없다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=12;align=left;verticalAlign=top;fontSize=11;">
          <mxGeometry x="420" y="820" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="범례" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#ffffff;strokeColor=#333333;rounded=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;container=1;collapsible=0;dashed=1;">
