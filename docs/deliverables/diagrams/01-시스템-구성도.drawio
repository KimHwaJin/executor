          <mxGeometry x="215" y="40" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="저장소" vertex="1" parent="c30" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;">
          <mxGeometry x="315" y="40" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="실선 = 요청·기록 방향 · 점선 = 서비스를 거치지 않는 직접 접근&lt;br&gt;①~⑥ = 실행 1건의 처리 순서" vertex="1" parent="c30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=12;align=left;verticalAlign=top;">
          <mxGeometry x="15" y="80" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;끊기면&lt;/b&gt;&lt;br&gt;PostgreSQL: 서비스 전체 중단 (readiness 실패)&lt;br&gt;Redis: 이벤트만 지연, Outbox에 쌓였다가 복구 후 순서대로 발행&lt;br&gt;공유 PV: 제출과 Step 마감 실패&lt;br&gt;Jupyter Target: 해당 Target만 OFFLINE, 다른 Target으로 배정" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=12;align=left;verticalAlign=top;">
          <mxGeometry x="1180" y="540" width="440" height="120" as="geometry" />
        </mxCell>
