<mxfile host="app.diagrams.net" compressed="false">
  <diagram name="장애 판단 흐름" id="page-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;운영자 장애 판단 흐름&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=12;fontSize=15;align=left;">
          <mxGeometry x="30" y="8" width="800" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;증상 접수&lt;/b&gt;&lt;br&gt;실행이 안 끝남 · 오류 응답 · 이벤트 안 옴" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;">
          <mxGeometry x="40" y="60" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="/readyz가 200인가?" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;rounded=0;fontSize=11;">
          <mxGeometry x="50" y="170" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;PostgreSQL 확인&lt;/b&gt;&lt;br&gt;checks.postgresql=false → DB 연결·리비전&lt;br&gt;worker_accepting=false → 기동·종료 중" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;fontSize=11;align=left;spacingLeft=8;">
          <mxGeometry x="330" y="175" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="제출이 202로&lt;br&gt;접수되는가?" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;rounded=0;fontSize=11;">
          <mxGeometry x="50" y="300" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;오류 코드로 분기&lt;/b&gt;&lt;br&gt;401/403 → API 키 · 테넌트&lt;br&gt;422 → 요청 형식 · 프로필&lt;br&gt;503 → DB 풀 고갈, 공유 PV" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;fontSize=11;align=left;spacingLeft=8;">
          <mxGeometry x="330" y="300" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="QUEUED에서&lt;br&gt;오래 머무는가?" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;rounded=0;fontSize=11;">
          <mxGeometry x="50" y="440" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;대기 사유 확인&lt;/b&gt; (상태 조회의 state.reason)&lt;br&gt;NO_ACTIVE_TARGET · CAPACITY_FULL · MEMORY_LIMIT&lt;br&gt;→ Target 상태, 슬롯, 메모리&lt;br&gt;ADMISSION_DRAINING → 접수 재개" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;fontSize=11;align=left;spacingLeft=8;">
          <mxGeometry x="330" y="435" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="RUNNING인데&lt;br&gt;진행이 없는가?" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;rounded=0;fontSize=11;">
          <mxGeometry x="50" y="580" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;/workerz와 lease 확인&lt;/b&gt;&lt;br&gt;lease 만료 → 15초 안에 회수되는지&lt;br&gt;Jupyter Target OFFLINE 여부&lt;br&gt;Step 시간 제한 설정" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;fontSize=11;align=left;spacingLeft=8;">
          <mxGeometry x="330" y="575" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="상태는 끝났는데&lt;br&gt;이벤트가 안 오는가?" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;rounded=0;fontSize=11;">
          <mxGeometry x="50" y="720" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;Outbox와 Redis 확인&lt;/b&gt;&lt;br&gt;Outbox PENDING 적체 (진단 SQL)&lt;br&gt;이벤트 Stream 조회 API: pending, 소비자 그룹" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;fontSize=11;align=left;spacingLeft=8;">
          <mxGeometry x="330" y="720" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;실패 진단 API로 원인 확인&lt;/b&gt;&lt;br&gt;GET .../diagnostics, failure_type&lt;br&gt;TOOL_ERROR는 사용자 코드 문제" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11;align=left;spacingLeft=8;">
