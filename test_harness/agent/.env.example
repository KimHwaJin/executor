# LangGraph development server
LANGSMITH_TRACING=false

# OpenAI-compatible vLLM gateway. Leave TEST_AGENT_LLM_MODEL empty to use the
# deterministic bootstrap response without calling an LLM.
TEST_AGENT_LLM_BASE_URL=http://127.0.0.1:8080/v1
TEST_AGENT_LLM_MODEL=
TEST_AGENT_LLM_API_KEY=local-development-only
TEST_AGENT_ENABLE_NL_EXECUTION=true
TEST_AGENT_USER_ID=chat-ui-user
TEST_AGENT_PROJECT_ID=chat-ui-project
# scripts/chat_smoke.py only. Agent Chat UI selects one of the two Graph IDs directly.
TEST_AGENT_GRAPH_ID=executor_mcp_agent

# Executor integration targets for the next implementation stage.
EXECUTOR_MCP_URL=http://127.0.0.1:8000/mcp
EXECUTOR_REST_URL=http://127.0.0.1:8000/api/v1
EXECUTOR_REDIS_URL=redis://127.0.0.1:6379/0
# Executor writes executor.events.{tenant}; the local key's tenant is "dev".
EXECUTOR_EVENT_STREAM=executor.events.dev
# Required. The local-only key from docker-compose.yml; use the issued key elsewhere.
EXECUTOR_API_KEY=exe_local_dev_0123456789abcdef0123456789abcde
EXECUTOR_AGENT_CONSUMER_GROUP=executor-test-agent
EXECUTOR_SHARED_STORAGE_ROOT=../../shared_dir
EXECUTOR_EXECUTION_TIMEOUT_SECONDS=120
