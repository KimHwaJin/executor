# Application
APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
EXECUTOR_PORT=8000

# Docker Compose PostgreSQL bootstrap. Override local-only defaults outside development.
POSTGRES_DB=executor
POSTGRES_USER=executor
POSTGRES_PASSWORD=executor

# Do not commit production credentials. These values are only for docker compose locally.
DATABASE_URL=postgresql+psycopg://executor:executor@localhost:5432/executor
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=executor.events
REDIS_DEAD_LETTER_STREAM=executor.events.dlq
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100

# Comma-separated HTTP Host header allowlist. Replace for deployed hostnames.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Compose-only allowlists. Add the machine's LAN host/IP explicitly when testing remotely.
MCP_ALLOWED_HOSTS_DOCKER=localhost:*,127.0.0.1:*,testserver,executor:*
MCP_ALLOWED_ORIGINS_DOCKER=http://localhost:*,http://127.0.0.1:*

# Jupyter execution and fleet management.
JUPYTER_REQUEST_TIMEOUT_SECONDS=30
JUPYTER_ENABLED=true
JUPYTER_SERVER_NAME=local-jupyter
JUPYTER_ENDPOINT=http://127.0.0.1:8888
JUPYTER_TOKEN=change-me-local-only
JUPYTER_SECONDARY_TOKEN=change-me-secondary-local-only
JUPYTER_BATCH_PRIMARY_TOKEN=change-me-batch-primary-local-only
JUPYTER_BATCH_SECONDARY_TOKEN=change-me-batch-secondary-local-only
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This checked-in value is an insecure local-only placeholder. Use a secret in deployments.
JUPYTER_CREDENTIAL_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JUPYTER_POOL=INTERACTIVE
JUPYTER_MAX_CONCURRENT_EXECUTIONS=2
JUPYTER_HEALTH_POLL_INTERVAL_SECONDS=15
WORKSPACE_HOST_ROOT=/Users/kimhwajin/vscode/AX_PROJECT/executor/notebook_dir
WORKSPACE_JUPYTER_ROOT=/workspace/pv
EXECUTION_INLINE_SPEC_MAX_BYTES=262144
EXECUTION_FILE_SPEC_MAX_BYTES=52428800
EXECUTION_CONSUMER_GROUP=executor-workers
# Use the Kubernetes Pod name. Empty defaults to hostname-pid and is still unique per process.
EXECUTION_CONSUMER_NAME=
EXECUTION_PENDING_CLAIM_INTERVAL_SECONDS=5
EXECUTION_PENDING_CLAIM_IDLE_MILLISECONDS=30000
EXECUTION_PENDING_CLAIM_BATCH_SIZE=100
EXECUTION_LEASE_SECONDS=60
EXECUTION_HEARTBEAT_SECONDS=15
EXECUTION_DRAIN_TIMEOUT_SECONDS=30
EXECUTION_SHUTDOWN_CLEANUP_SECONDS=20
FAILED_KERNEL_RETENTION_SECONDS=3600
EXECUTION_MAX_RUNTIME_SECONDS=432000
DYNAMIC_STEP_WAIT_TIMEOUT_SECONDS=3600

# OpenTelemetry/Phoenix tracing. Export failures never fail execution processing.
TRACING_ENABLED=false
OTEL_SERVICE_NAME=executor-service
OTEL_PROJECT_NAME=executor-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_TIMEOUT_SECONDS=5
OTEL_SAMPLE_RATIO=1.0
