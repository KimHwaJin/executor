# LLM_MODEL_NAME overrides USER_LLM_MODEL in src/agent_config.py.
# Model-specific generation parameters are configured in agent_config.py.
# CRUD API database and process configuration
DATABASE_URL=postgresql+asyncpg://postgresql:postgresql@pg.frodo.com:5432/chat_app
REDIS_URL=redis://:redis@redis.frodo.com/0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
AGENT_WORKER_ENABLED=true
TASK_RECONCILER_ENABLED=true
# API lifespan(router_headoffice)과 전용 컨테이너가 이 값으로 병렬 루프를 탑니다.
AGENT_RUN_WORKER_PARALLEL=true
AGENT_RUN_WORKER_CONCURRENCY=4
TASK_RECONCILER_PARALLEL=true
TASK_RECONCILER_CONCURRENCY=4
# Internal OpenAI-compatible model
# MODEL_PROVIDER=openai_compatible
# MODEL_API_KEY=
# API_BASE_URL=http://hcp.llm.skhynix.com/v1

# Frodo server llm
MODEL_PROVIDER=openai_compatible
# Preset alias or deployed model name; unset/blank uses USER_LLM_MODEL.
# LLM_MODEL_NAME=gpt-oss-120b
LLM_MODEL_NAME=qwen38-27b-nvfp4
MODEL_API_KEY=dummy
API_BASE_URL=http://model.frodo.com/v1
# Workflow embedding model; dedicated endpoint optional, shares MODEL_API_KEY with the LLM.
# mock: synthetic vectors; openai_compatible: local or customer embedding API
# Optional dedicated embedding endpoint; blank uses API_BASE_URL
EMBEDDING_API_BASE_URL=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSION=1024

MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0

# 범용 기본값. JSON Schema API 지원이 확인된 서버에서는
# provider_json_schema로 변경할 수 있습니다.
MODEL_STRUCTURED_OUTPUT_MODE=prompt_json

# LangGraph PostgreSQL checkpoint persistence
CHECKPOINT_DB_URI=postgresql://postgresql:postgresql@pg.frodo.com:5432/agent
# 최초 checkpoint bootstrap에서만 true로 사용하고 API/Worker 런타임은 false로 둔다.
CHECKPOINT_SETUP_ON_START=false
LANGGRAPH_STRICT_MSGPACK=true

# Executor request body target
EXECUTOR_BASE_URL=http://executor.frodo.com
# 개발용 false. 운영에서는 사내 CA를 신뢰 저장소에 설치하고 true 사용.
EXECUTOR_TLS_VERIFY=false
EXECUTOR_RUNTIME_PROFILE=default
# 필수. 이 서비스의 Executor tenant. 분석 에이전트가 이 tenant_id로 제출하고, Worker는
# {EW_EXECUTOR_EVENT_STREAM}.{tenant} Stream만 받는다. pr-batch에 배치를 등록할 때도
# 같은 값을 tenant_id로 보낸다. API와 Worker에 같은 값을 준다.
EXECUTOR_TENANT_ID=dtest
EXECUTOR_EXECUTIONS_PATH=/api/v1/executions
EXECUTOR_OPERATIONS_PATH=/api/v1/executions/{execution_id}/operations
EXECUTOR_EXECUTION_PATH=/api/v1/executions/{execution_id}
EXECUTOR_RESULT_PATH=/api/v1/executions/{execution_id}/result
EXECUTOR_NOTEBOOK_PATH=/api/v1/executions/{execution_id}/notebook
EXECUTOR_FINALIZE_PATH=/api/v1/executions/{execution_id}/finalize
EXECUTOR_CANCEL_PATH=/api/v1/executions/{execution_id}/cancel
EXECUTOR_ARTIFACTS_PATH=/api/v1/executions/{execution_id}/artifacts
# Agent와 Executor가 동일하게 마운트하는 공유 PV 루트입니다.
EXECUTOR_SHARED_INPUT_ROOT=/workspace/shared
#API, MANIFEST
EXECUTOR_RESULT_READ_MODE=API
EXECUTOR_SHARED_RESULT_ROOT=/workspace/shared
# true이면 데이터 선택값은 유지하되 wide mock parquet을 data_load로 직접 로드합니다.
DATA_MOCK=false
MOCK_DATA_ROOT=/workspace/pv
# PATH: 공유 PV의 .py 경로와 SHA-256 전달
# INLINE: 생성된 Python 코드를 요청 content에 직접 전달
EXECUTOR_SOURCE_TYPE=INLINE
EXECUTOR_REPORT_SOURCE_TYPE=INLINE
EXECUTOR_REPORT_APPEND_TO_NOTEBOOK=true
# HTTP 호출 timeout과 실제 Operation/다음 Operation 대기 timeout은 별도입니다.
EXECUTOR_OPERATION_TIMEOUT_SECONDS=300
EXECUTOR_OPERATION_WAIT_TIMEOUT_SECONDS=300
EXECUTOR_TIMEOUT_SECONDS=30
EXECUTOR_SUBMIT_ENABLED=true

# Local demo JSON artifacts (no notebook execution)
DEMO_ARTIFACTS_ENABLED=false
DEMO_ARTIFACTS_ROOT=demo_artifacts

# Phoenix is normally read from root config.dev.yml
PHOENIX_CONFIG_PATH=config.dev.yml
PHOENIX_PROJECT_NAME=dtest

# Workflow recommendation
WORKFLOW_RECOMMENDATION_ENABLED=true
# Agent recommends at or above this cosine similarity; lower scores generate a workflow.
WORKFLOW_SIMILARITY_SCORE=0.8
# Maximum recommendation candidates (1..20).
WORKFLOW_RECOMMENDATION_LIMIT=3
# Target candidates per generation/regeneration round (1..20); duplicates may yield fewer.
WORKFLOW_GENERATION_LIMIT=2

# Windows console/file decoding for LangGraph dev
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# executor worker
EW_DATABASE_URL=postgresql://postgresql:postgresql@pg.frodo.com:5432/agent
EW_REDIS_URL=redis://:redis@redis.frodo.com/0
EW_NAMESPACE=dtest-agent
EW_EXECUTOR_BASE_URL=http://executor.frodo.com
EW_EXECUTOR_EVENT_STREAM=executor.events
EW_EVENT_GROUP_NAME=dtest-agent:ingress
EW_COMMAND_STREAM_NAME=dtest-agent:commands
EW_COMMAND_GROUP_NAME=dtest-agent:dispatch
EW_INSTANCE_ID=dtest-agent-uid
EW_INGRESS_CONCURRENCY=4
EW_DISPATCH_CONCURRENCY=4
EW_LEASE_RENEW_SECONDS=10
EW_POOL_SIZE=8
# 처리가 끝났거나 아무도 받지 않는 ew_inbox/ew_commands 행 보관 일수. 0이면 정리하지 않는다.
EW_RETENTION_DAYS=14
# true면 이 tenant의 BATCH 실행이 성공할 때 리포트 에이전트를 실행한다.
AGENT_REPORT_ENABLED=false
EW_BATCH_SIZE=100
EW_HEALTH_PORT=8011

# checkpoint tables. It may be the same physical DB as EW_DATABASE_URL.
AGENT_CHECKPOINT_DATABASE_URL=postgresql://postgresql:postgresql@pg.frodo.com:5432/agent

# Local Azure OpenAI testing (set MODEL_PROVIDER=azure_openai)
# MODEL_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://pluto-openai.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Embeddings are configured independently of MODEL_PROVIDER.
# To keep real embeddings, set EMBEDDING_API_BASE_URL and MODEL_API_KEY
# for your OpenAI-compatible embedding server (see docs/local_embedding_server.md).
# To test with synthetic vectors without an embedding server:
# EMBEDDING_PROVIDER=mock


CONTEXT_INPUT_BUDGET_TOKENS=32000
CONTEXT_SUMMARY_TRIGGER_TOKENS=8000
