# Application
# Relative to the process working directory; use an absolute path elsewhere.
LOG_CONFIG_FILE=./logger.yml
# Optional root level override. Unset to use root.level from logger.yml.
# LOG_LEVEL=INFO
# Failed REST Execution commands only. Body is NOT masked; restrict log access.
REST_ERROR_BODY_LOGGING_ENABLED=false
REST_ERROR_BODY_LOG_MAX_BYTES=65536
HOST=0.0.0.0
PORT=8000
EXECUTOR_PORT=8000

# Shared infrastructure Compose; override local-only defaults outside development.
SHARED_INFRA_NETWORK=shared-infra
# Independent Jupyter Runtime Compose network, also joined by Executor.
RUNTIME_NETWORK=executor-runtimes
# Existing local volume names are retained when moving out of the Executor project.
SHARED_POSTGRES_VOLUME=executor_executor-postgres
SHARED_REDIS_VOLUME=executor_executor-redis-608
# PostgreSQL bootstrap applies only to an empty volume.
POSTGRES_DB=executor
POSTGRES_USER=executor
POSTGRES_PASSWORD=executor

# Do not commit production credentials. These values are only for docker compose locally.
DATABASE_URL=postgresql+psycopg://executor:executor@localhost:5432/executor
# Application default is false; this local example opts into auto-migration.
DB_AUTO_MIGRATE=true
DB_MIGRATIONS_PATH=./migrations
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=60
DB_MIGRATION_STATEMENT_TIMEOUT_SECONDS=300
# Maximum connections per Executor process = DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Shared Compose server default: redis:6.0.8 (image set in docker-compose.infra.yml).
# This URL selects the connection, not the Redis server version.
REDIS_URL=redis://localhost:6379/0
# These service deadlines override Redis URL socket-timeout query options.
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=10
REDIS_EVENT_STREAM=executor.events
# Optional approximate cap (XADD MAXLEN ~) per event Stream, tenant Streams
# included. Leave unset to bound event Streams by age only.
# REDIS_EVENT_STREAM_MAXLEN=100000
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
EVENT_RETENTION_ENABLED=true
EVENT_RETENTION_INTERVAL_SECONDS=3600
# Maximum DB rows per category and Redis deletions per Stream per pass.
EVENT_RETENTION_BATCH_SIZE=1000
REDIS_EVENT_RETENTION_SECONDS=604800
PUBLISHED_OUTBOX_RETENTION_SECONDS=604800
EXECUTION_EVENT_RETENTION_SECONDS=7776000

# Comma-separated HTTP Host header allowlist. Replace for deployed hostnames.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Compose-only allowlists. Add the machine's LAN host/IP explicitly when testing remotely.
MCP_ALLOWED_HOSTS_DOCKER=localhost:*,127.0.0.1:*,testserver,executor:*
MCP_ALLOWED_ORIGINS_DOCKER=http://localhost:*,http://127.0.0.1:*

# Runtime Targets and their credentials are registered only through REST or MCP.
# Local JupyterLab tokens (docker-compose.runtime.yml).
JUPYTER_TOKEN=default
JUPYTER_SECONDARY_TOKEN=default
JUPYTER_BATCH_PRIMARY_TOKEN=default
JUPYTER_BATCH_SECONDARY_TOKEN=default
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This checked-in value is an insecure local-only placeholder. Use a secret in deployments.
RUNTIME_CREDENTIAL_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RUNTIME_SESSION_COUNT_MAX_AGE_SECONDS=45
RUNTIME_CLEANUP_RETRY_INTERVAL_SECONDS=60
# Jupyter's extension records each execution; the Executor follows its
# journal stream and gives up after this long without a connection.
# Requires the matching Jupyter extension; install it before this Executor.
JUPYTER_STREAM_RECONNECT_SECONDS=30
# Executor writes source snapshots, outputs and manifests under this root.
# All result references are relative to this root.
SHARED_STORAGE_ROOT=./shared_dir
# Optional: caller-authored code/report PATH inputs, read-only from Executor.
# Unset/empty uses SHARED_STORAGE_ROOT. No requests/ prefix is added.
# Split example: INPUT_STORAGE_ROOT=/mnt/data/agent,
#               SHARED_STORAGE_ROOT=/mnt/data/executor
# INPUT_STORAGE_ROOT=./agent_dir
# Compose-only container path; use an additional volume mount when outside /workspace/shared.
# INPUT_STORAGE_ROOT_DOCKER=/workspace/shared/agent
EXECUTION_INLINE_SPEC_MAX_BYTES=262144
EXECUTION_FILE_SPEC_MAX_BYTES=52428800
EXECUTION_MAX_STEPS_PER_OPERATION=100
EXECUTION_MAX_STEPS_PER_EXECUTION=1000
EXECUTION_LEASE_SECONDS=60
EXECUTION_HEARTBEAT_SECONDS=15
EXECUTION_DRAIN_TIMEOUT_SECONDS=30
EXECUTION_SHUTDOWN_CLEANUP_SECONDS=20
# Maximum wait for Runtime interrupt plus positive idle confirmation.
RUNTIME_ABORT_TIMEOUT_SECONDS=15
# Maximum bytes for one incoming Runtime WebSocket message. Base64 images are
# measured in their JSON/base64 transport form, not decoded file size.
RUNTIME_MAX_OUTPUT_MESSAGE_BYTES=33554432
FAILED_SESSION_RETENTION_SECONDS=3600
EXECUTION_MAX_RUNTIME_SECONDS=432000
