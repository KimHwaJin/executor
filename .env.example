# Local runs only. Settings default in src/executor_service/settings.py;
# add any setting here (same name) to override it locally. Deployments set
# APP_ENV and read config.{APP_ENV}.yml instead; .env is ignored there.

# Executor on the host (uv run executor-service) reaches the Compose
# infrastructure through these. Do not commit real credentials.
DATABASE_URL=postgresql+psycopg://executor:executor@localhost:5432/executor
REDIS_URL=redis://localhost:6379/0
# Code default is false; local runs migrate on startup.
DB_AUTO_MIGRATE=true
# Every API call needs X-Api-Key. This local-only client is the key the
# scripts/ smoke tests send (exe_local_dev_0123456789abcdef0123456789abcde).
AUTH_CLIENTS=[{"name": "local", "key_sha256": ["b061e43ebf6dc8828ff97157745da7b61b921a83a2e1d2122e8ae0c6bd527d7b"], "tenant": "dev", "relay": true, "allowed_tenants": ["*"], "admin": true}]
# Insecure local-only Fernet placeholder (the code default). Generate a real key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RUNTIME_CREDENTIAL_KEY=
# Swagger /docs, /redoc, /openapi.json are on by default and in dev;
# config.stg.yml and config.prd.yml turn them off (internal-network rules).
# DOCS_ENABLED=false
# Optional caller-authored PATH input root; unset uses SHARED_STORAGE_ROOT.
# INPUT_STORAGE_ROOT=./agent_dir

# Compose (docker compose up) variables.
EXECUTOR_PORT=8000
SHARED_INFRA_NETWORK=shared-infra
RUNTIME_NETWORK=executor-runtimes
# Existing local volume names are retained when moving out of the Executor project.
SHARED_POSTGRES_VOLUME=executor_executor-postgres
SHARED_REDIS_VOLUME=executor_executor-redis-608
# PostgreSQL bootstrap applies only to an empty volume.
POSTGRES_DB=executor
POSTGRES_USER=executor
POSTGRES_PASSWORD=executor
# Allowlists inside the Executor container. Add the machine's LAN host/IP to test remotely.
MCP_ALLOWED_HOSTS_DOCKER=localhost:*,127.0.0.1:*,testserver,executor:*
MCP_ALLOWED_ORIGINS_DOCKER=http://localhost:*,http://127.0.0.1:*
# Container path for INPUT_STORAGE_ROOT; mount the directory if outside /workspace/shared.
# INPUT_STORAGE_ROOT_DOCKER=/workspace/shared/agent

# Local JupyterLab tokens (docker-compose.runtime.yml). Runtime Targets and
# their credentials are registered only through REST or MCP.
JUPYTER_TOKEN=default
JUPYTER_SECONDARY_TOKEN=default
JUPYTER_BATCH_PRIMARY_TOKEN=default
JUPYTER_BATCH_SECONDARY_TOKEN=default
